# SmartCart AI - Environment Configuration Template
# Copy to .env and customize for your deployment environment

# Server Gateway
APP_NAME="SmartCart AI API"
APP_ENV=development
APP_PORT=8000
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-secure-random-key-in-production

# Database (PostgreSQL for production, SQLite for local dev/testing)
DATABASE_URL=sqlite:///./smartcart.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/smartcart

# Verification Engine Parameters
CORRELATION_WINDOW_SECONDS=15.0
WEIGHT_TOLERANCE_GRAMS=50.0
MIN_VERIFICATION_CONFIDENCE=0.85
ALLOW_INCONCLUSIVE_CHECKOUT_BYPASS=false

# Computer Vision & Shelf Auditing
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
IMAGE_MAX_SIZE_MB=10
MEDIA_UPLOAD_DIR=backend/app/data/uploads
